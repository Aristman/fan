{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@itone/fan-ai": ["./packages/ai/src/index.ts"],
			"@itone/fan-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@itone/fan-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@itone/fan-ai/dist/*": ["./packages/ai/src/*"],
			"@itone/fan-agent-core": ["./packages/agent/src/index.ts"],
			"@itone/fan-agent-core/*": ["./packages/agent/src/*"],
			"@itone/fan-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@itone/fan-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@itone/fan-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@sinclair/typebox": ["./node_modules/@sinclair/typebox"],
			"@itone/fan-tui": ["./packages/tui/src/index.ts"],
			"@itone/fan-tui/*": ["./packages/tui/src/*"],
			"@itone/fan-web-ui": ["./packages/web-ui/src/index.ts"],
			"@itone/fan-web-ui/*": ["./packages/web-ui/src/*"],
			"@fan/db": ["./packages/db/src/index.ts"],
			"@fan/db/*": ["./packages/db/src/*"],
			"@fan/orchestrator": ["./packages/orchestrator/src/index.ts"],
			"@fan/orchestrator/*": ["./packages/orchestrator/src/*"],
			"@fan/model-manager": ["./packages/model-manager/src/index.ts"],
			"@fan/model-manager/*": ["./packages/model-manager/src/*"]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": ["packages/web-ui/**/*", "**/dist/**"]
}
