# Voice Input for TUI (Ollama) — Configuration
# Copy this file to .env and adjust values as needed.

# Audio
# AUDIO_DEVICE=default
# RECORD_DURATION_MAX=60

# Whisper
# WHISPER_BIN_PATH=whisper-cli
# WHISPER_MODEL_PATH=/home/user/.fan/models/speech/ggml-base.bin
# WHISPER_LANGUAGE=auto

# Ollama
# OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_SYSTEM_PROMPT=Fix punctuation and obvious typos. Preserve meaning and language. Return ONLY corrected text.

# UI
# SHORTCUT=ctrl+shift+space
