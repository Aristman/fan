# ============================================
# FAN Runtime - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to version control.

# --- AI Provider API Keys ---
# At least one provider key is required.
# Uncomment and fill in the provider(s) you want to use.

# OpenAI
# OPENAI_API_KEY=

# Azure OpenAI (Responses API)
# AZURE_OPENAI_API_KEY=

# Anthropic (Claude)
# Anthropic supports either an API key or OAuth token (OAuth takes precedence).
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=

# Google Gemini
# GEMINI_API_KEY=

# Google Vertex AI
# Auth can be configured via:
#   1. GOOGLE_CLOUD_API_KEY env var (explicit API key)
#   2. Application Default Credentials (ADC) via gcloud CLI
#      Requires: gcloud auth application-default login
#      Plus the project and location vars below:
# GOOGLE_CLOUD_API_KEY=
# GOOGLE_CLOUD_PROJECT=my-project
# GCLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Groq
# GROQ_API_KEY=

# Cerebras
# CEREBRAS_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# xAI (Grok)
# XAI_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Vercel AI Gateway
# AI_GATEWAY_API_KEY=

# ZAI
# ZAI_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# MiniMax
# MINIMAX_API_KEY=

# MiniMax CN (China region)
# MINIMAX_CN_API_KEY=

# Hugging Face
# HF_TOKEN=

# OpenCode
# OPENCODE_API_KEY=

# Kimi Coding
# KIMI_API_KEY=

# GitHub Copilot
# Supports COPILOT_GITHUB_TOKEN, GH_TOKEN, or GITHUB_TOKEN.
# COPILOT_GITHUB_TOKEN=

# Amazon Bedrock
# Supports multiple credential sources:
#   AWS_PROFILE          - named profile from ~/.aws/credentials
#   AWS_ACCESS_KEY_ID    + AWS_SECRET_ACCESS_KEY  - standard IAM keys
#   AWS_BEARER_TOKEN_BEDROCK                  - Bedrock API keys (bearer token)
#   AWS_CONTAINER_CREDENTIALS_RELATIVE_URI    - ECS task roles
#   AWS_CONTAINER_CREDENTIALS_FULL_URI        - ECS task roles (full URI)
#   AWS_WEB_IDENTITY_TOKEN_FILE               - IRSA (IAM Roles for Service Accounts)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=

# --- FAN Runtime Settings ---

# Disable API gateway token authentication (local dev only).
# When set to "1" or "true", all API requests are allowed without a token.
# FAN_NO_AUTH=false

# Offline mode — disables all startup network operations.
# Also automatically sets FAN_SKIP_VERSION_CHECK=1.
# Set to "1", "true", or "yes" to enable.
# FAN_OFFLINE=false

# Skip the version check on startup.
# FAN_SKIP_VERSION_CHECK=false

# Custom agent config directory (default: ~/.fan/agent).
# Used for models.json, settings.json, auth.json, sessions, etc.
# FAN_CODING_AGENT_DIR=

# Custom package directory (for Nix/Guix where store paths tokenize poorly).
# Defaults to the directory containing the executable (Bun binary) or
# the nearest ancestor with package.json (Node.js).
# FAN_PACKAGE_DIR=

# Base URL for the /share command (default: https://pi.dev/session/).
# FAN_SHARE_VIEWER_URL=

# --- API Gateway Server ---
# The server port and host are configured via CLI args (--port, --host)
# or programmatically via ServerOptions. No dedicated env vars currently.

# --- Database ---
# Prisma/SQLite connection string. The database file (fan.db) is stored
# inside the agent config directory (FAN_CODING_AGENT_DIR or ~/.fan/agent/).
# DATABASE_URL=file:./fan.db

# --- Database Logging ---
# Prisma query log level. Set to "query" to log all DB queries.
# FAN_DB_LOG=error

# --- TUI / Terminal Settings ---

# Show hardware cursor in the TUI instead of a custom rendered cursor.
# FAN_HARDWARE_CURSOR=false

# Clear empty rows when content shrinks in the TUI.
# FAN_CLEAR_ON_SHRINK=false

# --- Node.js TLS ---

# Use system CA certificate store for TLS verification.
# Required when connecting to endpoints with custom/self-signed root CAs
# that are trusted by the OS but not included in Node.js's bundled CA list.
# NODE_OPTIONS=--use-system-ca

# --- Debug & Diagnostics ---

# Enable timing instrumentation. Set to "1" to enable.
# FAN_TIMING=false

# Enable startup benchmark reporting (interactive mode only).
# FAN_STARTUP_BENCHMARK=false
