#!/usr/bin/env bash
#
# fan-store — CLI tool for managing a local FAN package repository
#
# Usage:
#   fan-store init [path]            Create a new repo directory
#   fan-store add <archive.tar.gz>   Add package to repo (updates index.json)
#   fan-store remove <name>          Remove package from repo
#   fan-store list                   List all packages
#   fan-store info <name>            Show package details
#   fan-store publish [target]       Deploy repo to server
#   fan-store serve [port]           Local test server
#   fan-store set-url <url>          Override repository base URL
#
set -euo pipefail

# ── Config ──────────────────────────────────────────────
# SSH config-based alias (recommended). Configure in ~/.ssh/config:
#   Host fan-store-server
#       HostName 185.219.41.46
#       User root
#       IdentityFile ~/.ssh/fan-store-deploy
DEFAULT_REMOTE_TARGET="fan-store-server:/opt/repos/fan-store"
# Legacy fallback (if SSH config is not set up):
REMOTE_HOST="root@185.219.41.46"
REMOTE_PATH="/opt/repos/fan-store"
REPO_URL="https://fan.sea-agents.ru/fan-store"
REPO_DIR=""

# ── Latest-only flag ────────────────────────────────────────
# Default: latest-only ON (only the latest version of each package)
# Use --all or FAN_STORE_FULL_REBUILD=1 for full rebuild (all versions)
LATEST_ONLY=1

# If user explicitly wants full rebuild via env vars
if [ "${FAN_STORE_LATEST_ONLY:-}" = "0" ] || [ "${FAN_STORE_LATEST_ONLY:-}" = "false" ]; then
    LATEST_ONLY=0
fi
if [ "${FAN_STORE_FULL_REBUILD:-}" = "1" ] || [ "${FAN_STORE_FULL_REBUILD:-}" = "true" ]; then
    LATEST_ONLY=0
fi

# ── Force upload flag ────────────────────────────────────────
# Default: skip existing files on the server (--ignore-existing)
# Use --force or FAN_STORE_FORCE_UPLOAD=1 to re-upload everything
FORCE_UPLOAD=0

if [ "${FAN_STORE_FORCE_UPLOAD:-}" = "1" ] || [ "${FAN_STORE_FORCE_UPLOAD:-}" = "true" ]; then
    FORCE_UPLOAD=1
fi

# Parse --latest-only, --all, and --force from args and strip them from positional args
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --latest-only) LATEST_ONLY=1 ;;
        --all) LATEST_ONLY=0 ;;
        --force) FORCE_UPLOAD=1 ;;
        *) ARGS+=("$arg") ;;
    esac
done
set -- "${ARGS[@]}"

# ── Colors ──────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

info()  { echo -e "${GREEN}✔${NC} $*"; }
warn()  { echo -e "${YELLOW}!${NC} $*"; }
error() { echo -e "${RED}✖${NC} $*" >&2; exit 1; }
dim()   { echo -e "${DIM}$*${NC}"; }

# ── Helpers ─────────────────────────────────────────────
find_repo_dir() {
    if [[ -n "${FAN_REPO_DIR:-}" && -f "$FAN_REPO_DIR/index.json" ]]; then
        REPO_DIR="$FAN_REPO_DIR"
        return
    fi
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/index.json" ]]; then
            REPO_DIR="$dir"
            return
        fi
        dir=$(dirname "$dir")
    done
    error "Not a fan-store directory (no index.json found). Run 'fan-store init' first."
}

assert_repo_clean() {
    require_repo

    local banned=()

    # 1. Корень репы — не должно быть install-скриптов
    for name in install.ps1 install.sh manifest.json .env .env.example; do
        if [ -e "$REPO_DIR/$name" ]; then
            banned+=("$name")
        fi
    done

    # 2. packages/ — не должно быть бинарников FAN
    if [ -d "$REPO_DIR/packages" ]; then
        for f in "$REPO_DIR/packages"/fan-*.tar.gz "$REPO_DIR/packages"/fan-*.zip; do
            if [ -e "$f" ]; then
                banned+=("$(basename "$f")")
            fi
        done
    fi

    # 3. Корень — не должно быть исходников
    for ext in ts js tsx cjs mjs; do
        for f in "$REPO_DIR"/*."$ext"; do
            if [ -e "$f" ]; then
                banned+=("$(basename "$f")")
            fi
        done
    done

    if [ ${#banned[@]} -gt 0 ]; then
        echo ""
        echo "❌ REFUSED: Repository contains files that don't belong to fan-store:" >&2
        for name in "${banned[@]}"; do
            echo "   - $name" >&2
        done
        echo ""
        echo "This usually means the FAN binary release was copied into the store repo," >&2
        echo "or dev files (.env, .ts, .js) leaked here. Please move them elsewhere and try again." >&2
        exit 1
    fi
}

require_repo() {
    find_repo_dir
    if [[ ! -f "$REPO_DIR/index.json" ]]; then
        error "index.json not found in $REPO_DIR"
    fi
}

# Extract a field from package.json inside a tar.gz
tar_field() {
    local archive="$1" field="$2"
    local pkg_json_path
    # Prefer root-level package.json (<dirname>/package.json), fall back to any
    pkg_json_path=$(tar -tzf "$archive" 2>/dev/null | grep -E '^[^/]+/package\.json$' | head -1 || true)
    if [[ -z "$pkg_json_path" ]]; then
        pkg_json_path=$(tar -tzf "$archive" 2>/dev/null | grep -m1 'package.json' || true)
    fi
    if [[ -z "$pkg_json_path" ]]; then
        echo ""
        return
    fi
    tar -xzf "$archive" -O "$pkg_json_path" 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    fan = data.get('fan', {})
    if fan.get('$field'):
        print(fan['$field'])
    else:
        print(data.get('$field', ''))
except: print('')
" 2>/dev/null || echo ""
}

# Detect package type from archive contents
detect_type() {
    local archive="$1"
    local contents
    contents=$(tar -tzf "$archive" 2>/dev/null | head -20 || true)
    # Check for SKILL.md and theme.json at root level first
    if echo "$contents" | grep -qE '^[^/]+/SKILL\.md$'; then
        echo "skill"; return
    fi
    if echo "$contents" | grep -qE '^[^/]+/theme\.json$'; then
        echo "theme"; return
    fi
    # Only classify as bundle if extensions/skills/themes are at top level
    if echo "$contents" | grep -qE '^[^/]+/(extensions/|skills/|themes/)'; then
        echo "bundle"; return
    fi
    # Re-check SKILL.md and theme.json without root anchor as fallback
    if echo "$contents" | grep -q 'SKILL.md'; then
        echo "skill"; return
    fi
    if echo "$contents" | grep -q 'theme\.json'; then
        echo "theme"; return
    fi
    if echo "$contents" | grep -qE '(index\.ts|index\.js|package\.json)'; then
        echo "extension"; return
    fi
    echo "unknown"
}

timestamp() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# Validate index.json integrity
test_index_valid() {
    local path="$1"
    if [ ! -f "$path" ]; then return 1; fi

    # Check first non-whitespace character
    local first
    first=$(head -c 3 "$path" | od -An -tx1 | tr -d ' ')
    # If starts with efbbbf (BOM), skip
    if [ "$first" = "efbbbf" ]; then
        first=$(head -c 4 "$path" | tail -c 1 | od -An -tx1 | tr -d ' ')
    fi
    # 7b is '{'
    if [ "$first" != "7b" ]; then
        return 1
    fi

    # Try to parse as JSON
    if ! python3 -c "import json; json.load(open('$path'))" 2>/dev/null; then
        return 1
    fi

    return 0
}

# Attempt to repair a corrupted index.json by running rebuild_index
repair_index() {
    local repo_dir="$1"
    echo "WARNING: index.json is corrupted, running rebuild_index..." >&2
    rebuild_index
}

# Rebuild index.json from packages/ directory
rebuild_index() {
    require_repo
    local packages_dir="$REPO_DIR/packages"
    local ts
    ts=$(timestamp)

    local pkg_array="[]"
    if [[ -d "$packages_dir" ]]; then
        pkg_array=$(FAN_PKG_DIR="$packages_dir" FAN_REPO_URL="$REPO_URL" FAN_REPO_DIR="$REPO_DIR" python3 << 'PYEOF'
import json, os, hashlib, glob, tarfile

packages = []
pkg_dir = os.environ["FAN_PKG_DIR"]
repo_url = os.environ["FAN_REPO_URL"]

for archive_path in sorted(glob.glob(os.path.join(pkg_dir, '*.tar.gz')) + glob.glob(os.path.join(pkg_dir, '*.tgz'))):
    filename = os.path.basename(archive_path)

    name = ''
    version = ''
    description = ''
    author = ''

    try:
        with tarfile.open(archive_path, 'r:gz') as tf:
            # Prefer root-level package.json (e.g. "skillname/package.json")
            root_pkg = None
            other_pkg = None
            for member in tf.getmembers():
                if member.name.endswith('package.json'):
                    parts = member.name.split('/')
                    if len(parts) == 2 and member.isfile():
                        root_pkg = member
                        break
                    elif other_pkg is None and member.isfile():
                        other_pkg = member
            target = root_pkg or other_pkg
            if target:
                f = tf.extractfile(target)
                if f:
                    try:
                        data = json.loads(f.read().decode())
                        fan = data.get('fan', {})
                        name = fan.get('name') or data.get('name', '')
                        version = fan.get('version') or data.get('version', '')
                        description = fan.get('description') or data.get('description', '')
                        author = fan.get('author') or data.get('author', '')
                    except: pass
    except: pass

    if not name:
        parts = filename.replace('.tar.gz', '').replace('.tgz', '').rsplit('-', 1)
        if len(parts) == 2:
            name = parts[0]
            version = parts[1]
        else:
            name = parts[0]

    type_ = 'extension'
    try:
        with tarfile.open(archive_path, 'r:gz') as tf:
            names = [m.name for m in tf.getmembers()]
            # Check root-level markers first
            if any(n.split('/')[0] + '/SKILL.md' == n for n in names):
                type_ = 'skill'
            elif any(n.split('/')[0] + '/theme.json' == n for n in names):
                type_ = 'theme'
            # Only classify as bundle if extensions/skills/themes at top level
            elif any(n.startswith(n.split('/')[0] + '/extensions/') or n.startswith(n.split('/')[0] + '/skills/') or n.startswith(n.split('/')[0] + '/themes/') for n in names):
                type_ = 'bundle'
            elif any('SKILL.md' in n for n in names):
                type_ = 'skill'
            elif any('theme.json' in n for n in names):
                type_ = 'theme'
    except: pass

    with open(archive_path, 'rb') as f:
        hash_val = 'sha256:' + hashlib.sha256(f.read()).hexdigest()

    base_url = repo_url.rstrip('/')
    download_url = f'{base_url}/packages/{filename}'

    pkg = {
        'name': name,
        'version': version,
        'type': type_,
        'description': description,
        'downloadUrl': download_url,
        'hash': hash_val,
    }
    if author:
        pkg['author'] = author
    packages.append(pkg)

# Sort: group by name (asc), then by version (desc) within each group
def sort_key(p):
    parts = p['version'].split('.')
    nums = []
    for part in parts:
        if part.isdigit():
            nums.append(-int(part))  # negative for descending
        else:
            nums.append(part)
    return (p['name'], tuple(nums))
packages.sort(key=sort_key)

print(json.dumps(packages, indent=2))
PYEOF
)
    fi

    FAN_PKG_ARRAY="$pkg_array" FAN_REPO_DIR="$REPO_DIR" FAN_REPO_URL="$REPO_URL" FAN_TS="$ts" FAN_LATEST_ONLY="$LATEST_ONLY" python3 << 'PYEOF'
import json, os, sys

packages = json.loads(os.environ["FAN_PKG_ARRAY"])
repo_dir = os.environ["FAN_REPO_DIR"]
repo_url = os.environ["FAN_REPO_URL"]
ts = os.environ["FAN_TS"]
latest_only = os.environ.get("FAN_LATEST_ONLY", "0") == "1"

# Apply latest-only filter: keep only the max version for each name
if latest_only:
    before = len(packages)
    versions = {}
    for p in packages:
        cur = versions.get(p["name"])
        if cur is None:
            versions[p["name"]] = p
        else:
            # Compare semver
            va = p["version"].split(".")
            vb = cur["version"].split(".")
            greater = False
            for i in range(3):
                na = int(va[i]) if i < len(va) and va[i].isdigit() else 0
                nb = int(vb[i]) if i < len(vb) and vb[i].isdigit() else 0
                if na > nb:
                    greater = True
                    break
                elif na < nb:
                    break
            if greater:
                versions[p["name"]] = p
    packages = list(versions.values())
    print(f"  Latest-only mode: {before} \u2192 {len(packages)} packages")

repo_name = os.path.basename(repo_dir)

try:
    with open(os.path.join(repo_dir, "index.json")) as f:
        existing = json.load(f)
        repo_name = existing.get("repository", {}).get("name", repo_name)
except: pass

index = {
    "repository": {
        "name": repo_name,
        "url": repo_url,
        "updatedAt": ts
    },
    "packages": packages
}

with open(os.path.join(repo_dir, "index.json"), "w") as f:
    json.dump(index, f, indent=2)
    f.write("\n")

print(f"  {len(packages)} package(s) in index")
PYEOF
}

# ── Commands ────────────────────────────────────────────

cmd_init() {
    local path="${1:-.}"
    path=$(realpath "$path")

    if [[ -f "$path/index.json" ]]; then
        error "Repo already exists at $path"
    fi

    mkdir -p "$path/packages"

    local repo_name
    repo_name=$(basename "$path")

    cat > "$path/index.json" <<EOF
{
  "repository": {
    "name": "$repo_name",
    "url": "$REPO_URL",
    "updatedAt": "$(timestamp)"
  },
  "packages": []
}
EOF

    info "Repository initialized at $path"
    echo ""
    dim "  $path/"
    dim "  ├── index.json"
    dim "  └── packages/"
    echo ""
    dim "Next: fan-store add ./my-extension-1.0.0.tar.gz"
    dim "       fan-store publish"
}

cmd_set_url() {
    local url="${1:-}"
    if [[ -z "$url" ]]; then
        echo "Current URL: $REPO_URL"
        return
    fi

    REPO_URL="${url%/}/"
    info "Repository URL set to $REPO_URL"
}

cmd_add() {
    assert_repo_clean

    local archive="${1:-}"
    if [[ -z "$archive" ]]; then
        error "Usage: fan-store add <archive.tar.gz>"
    fi

    archive=$(realpath "$archive")
    if [[ ! -f "$archive" ]]; then
        error "File not found: $archive"
    fi

    if [[ ! "$archive" =~ \.(tar\.gz|tgz)$ ]]; then
        warn "Expected .tar.gz or .tgz archive"
    fi

    require_repo

    local name version description type
    name=$(tar_field "$archive" "name")
    version=$(tar_field "$archive" "version")
    description=$(tar_field "$archive" "description")
    type=$(detect_type "$archive")

    if [[ -z "$name" ]]; then
        local basename_noext
        basename_noext=$(basename "$archive" | sed 's/\.tar\.gz$//' | sed 's/\.tgz$//')
        name=$(echo "$basename_noext" | sed 's/-[^-]*$//')
        version=$(echo "$basename_noext" | sed "s/^${name}-//")
    fi

    echo ""
    echo -e "  ${CYAN}Name:${NC}        $name"
    echo -e "  ${CYAN}Version:${NC}     $version"
    echo -e "  ${CYAN}Type:${NC}        $type"
    echo -e "  ${CYAN}Description:${NC} $description"
    echo ""

    local dest="$REPO_DIR/packages/$(basename "$archive")"
    cp "$archive" "$dest"
    info "Copied to packages/$(basename "$archive")"

    rebuild_index
    info "Package '$name' added to repository"
}

cmd_remove() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        error "Usage: fan-store remove <name>"
    fi

    require_repo

    local found=0
    for archive in "$REPO_DIR/packages/"*.tar.gz "$REPO_DIR/packages/"*.tgz; do
        [[ -f "$archive" ]] || continue
        local pkg_name
        pkg_name=$(tar_field "$archive" "name")
        if [[ -z "$pkg_name" ]]; then
            pkg_name=$(basename "$archive" | sed 's/\.tar\.gz$//' | sed 's/\.tgz$//' | sed 's/-[^-]*$//')
        fi
        if [[ "$pkg_name" == "$name" ]]; then
            rm "$archive"
            info "Removed $(basename "$archive")"
            found=1
        fi
    done

    if [[ "$found" == "0" ]]; then
        error "Package '$name' not found"
    fi

    rebuild_index
    info "Package '$name' removed from repository"
}

cmd_list() {
    require_repo

    # When --latest-only is active, rebuild index with filtering
    if [ "$LATEST_ONLY" = "1" ]; then
        rebuild_index
    fi

    echo ""
    echo -e "  ${CYAN}Repository:${NC}   $(basename "$REPO_DIR")"
    echo -e "  ${CYAN}URL:${NC}          ${REPO_URL:-<not set>}"
    echo -e "  ${CYAN}Directory:${NC}    $REPO_DIR"
    echo ""

    FAN_REPO_DIR="$REPO_DIR" python3 << 'PYEOF'
import json, os, sys

with open(os.path.join(os.environ["FAN_REPO_DIR"], "index.json")) as f:
    data = json.load(f)

packages = data.get("packages", [])
if not packages:
    print("  (empty)")
    sys.exit(0)

for i, pkg in enumerate(packages):
    name = pkg.get("name", "?")
    version = pkg.get("version", "?")
    type_ = pkg.get("type", "?")
    desc = pkg.get("description", "")
    author = pkg.get("author", "")
    hash_ = pkg.get("hash", "")[:16]

    print(f"  {i+1}. {name}@{version}")
    print(f"     type: {type_}")
    if desc:
        print(f"     desc: {desc}")
    if author:
        print(f"     author: {author}")
    print(f"     hash: {hash_}...")
    print()
PYEOF
}

cmd_info() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        error "Usage: fan-store info <name>"
    fi

    require_repo

    FAN_REPO_DIR="$REPO_DIR" FAN_PKG_NAME="$name" python3 << 'PYEOF'
import json, os, sys

with open(os.path.join(os.environ["FAN_REPO_DIR"], "index.json")) as f:
    data = json.load(f)

packages = data.get("packages", [])
pkg_name = os.environ["FAN_PKG_NAME"]
pkg = next((p for p in packages if p.get("name") == pkg_name), None)
if not pkg:
    print(f"Package not found: {pkg_name}", file=sys.stderr)
    sys.exit(1)

print(json.dumps(pkg, indent=2))
PYEOF
}

sync_repo_to_remote() {
    local repo_dir="$1"
    local remote="$2"
    local force="$3"
    
    # Get local files (excluding .git, *.bak.*)
    local local_files
    local_files=$(find "$repo_dir" -type f -not -path '*/.git/*' ! -name '*.bak.*' | sed "s|^$repo_dir/||" | sort)
    local local_count
    local_count=$(echo "$local_files" | wc -l)
    echo "Local files: $local_count"
    
    local server_files=""
    if [ "$force" = "0" ]; then
        # Get server files
        server_files=$(ssh "$remote" "cd /opt/repos/fan-store && find . -type f -not -path './.*'" | sort)
        local server_count
        server_count=$(echo "$server_files" | wc -l)
        echo "Server files: $server_count"
    fi
    
    # Find what needs syncing
    local to_sync
    to_sync=$(comm -23 <(echo "$local_files") <(echo "$server_files" 2>/dev/null | sed 's|^\./||'))
    
    if [ -z "$to_sync" ]; then
        echo "Nothing to sync — all files already on server"
        return
    fi
    
    local sync_count
    sync_count=$(echo "$to_sync" | wc -l)
    echo "Syncing $sync_count new files..."
    
    # Copy via scp
    local copied=0
    while IFS= read -r f; do
        if [ -n "$f" ]; then
            scp "$repo_dir/$f" "$remote:/opt/repos/fan-store/$f" >/dev/null 2>&1
            if [ $? -eq 0 ]; then
                copied=$((copied + 1))
            fi
        fi
    done <<< "$to_sync"
    
    echo "Copied $copied / $sync_count files"

    # ── index.json integrity validation ──────────────────────────────────
    echo "Validating index.json integrity..."
    if ! test_index_valid "$repo_dir/index.json"; then
        echo "❌ index.json is corrupted locally!" >&2
        repair_index "$repo_dir"
        if test_index_valid "$repo_dir/index.json"; then
            echo "✅ Repaired. Re-syncing to server..." >&2
            scp "$repo_dir/index.json" "$remote:/opt/repos/fan-store/index.json"
        else
            echo "❌ Failed to repair. Refusing to publish." >&2
            exit 1
        fi
    fi

    # Verify server version
    echo "Verifying server index.json..."
    local server_idx
    server_idx=$(ssh "$remote" "cat /opt/repos/fan-store/index.json" 2>/dev/null || true)
    if ! echo "$server_idx" | grep -q "^{"; then
        echo "❌ Server index.json missing '{'! Re-syncing..." >&2
        scp "$repo_dir/index.json" "$remote:/opt/repos/fan-store/index.json"
    fi
}

cmd_publish() {
    local target="${1:-$DEFAULT_REMOTE_TARGET}"

    assert_repo_clean
    require_repo

    rebuild_index

    if [[ "$target" =~ ^s3:// ]]; then
        if ! command -v aws &>/dev/null; then
            error "AWS CLI not installed. Install with: pip install awscli"
        fi
        info "Syncing to S3: $target"
        aws s3 sync "$REPO_DIR/" "$target/" --delete
        info "Published to S3"

    elif [[ "$target" =~ ^https?:// ]]; then
        error "HTTP publish not yet supported. Use SCP target: user@host:/path"

    else
        # SSH target: user@host:/path
        local remote_host
        remote_host=$(echo "$target" | cut -d: -f1)

        if [ "$FORCE_UPLOAD" = "1" ]; then
            dim "  scp: force upload (re-uploading all files)"
        else
            dim "  scp: smart sync — checking server for existing files..."
        fi

        info "Syncing to $target ..."
        sync_repo_to_remote "$REPO_DIR" "$remote_host" "$FORCE_UPLOAD"
        info "Published to $target"
    fi
}

cmd_serve() {
    local port="${1:-8888}"
    require_repo

    info "Serving repository at http://localhost:$port/"
    dim "  Press Ctrl+C to stop"
    echo ""
    cd "$REPO_DIR"
    python3 -m http.server "$port"
}

cmd_help() {
    echo ""
    echo -e "${CYAN}fan-store${NC} — FAN package repository manager"
    echo ""
    echo "Usage: fan-store <command> [args] [--latest-only|--all|--force]"
    echo ""
    echo "Commands:"
    echo "  init [path]            Create a new repository directory"
    echo "  set-url <url>          Set repository base URL"
    echo "  add <archive.tar.gz>   Add package to repository"
    echo "  remove <name>          Remove package by name"
    echo "  list                   List all packages (latest-only by default; use --all for all versions)"
    echo "  info <name>            Show package details"
    echo "  publish [target]       Deploy to server (default: root@185.219.41.46:/var/www/html/fan-store)"
    echo "  serve [port]           Local HTTP server for testing"
    echo "  help                   Show this help"
    echo ""
    echo "Default server: root@185.219.41.46:/var/www/html/fan-store"
    echo "Default URL:    https://fan.sea-agents.ru/fan-store/"
    echo "Environment:"
    echo "  FAN_REPO_DIR               Override repository directory"
    echo "  FAN_STORE_LATEST_ONLY      Set to 0 or false to disable latest-only"
    echo "  FAN_STORE_FULL_REBUILD     Set to 1 or true to force full rebuild (all versions)"
    echo "  FAN_STORE_FORCE_UPLOAD     Set to 1 or true to force re-upload all files"
    echo ""
    echo "By default: latest-only mode (only the latest version of each package)."
    echo "Use --all or FAN_STORE_FULL_REBUILD=1 for full rebuild (all versions)."
    echo "By default: publish skips existing files on the server (--ignore-existing)."
    echo "Use --force or FAN_STORE_FORCE_UPLOAD=1 to force re-upload all files."
    echo ""
}

# ── Main ────────────────────────────────────────────────
COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    init)      cmd_init "$@" ;;
    set-url)   cmd_set_url "$@" ;;
    add)       cmd_add "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    list|ls)   cmd_list "$@" ;;
    info|show) cmd_info "$@" ;;
    publish|push|deploy) cmd_publish "$@" ;;
    serve)     cmd_serve "$@" ;;
    help|--help|-h|"") cmd_help ;;
    *)         error "Unknown command: $COMMAND. Run 'fan-store help'." ;;
esac
