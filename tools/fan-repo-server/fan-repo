#!/usr/bin/env bash
#
# fan-repo — CLI tool for managing a local FAN package repository
#
# Usage:
#   fan-repo init [path]            Create a new repo directory
#   fan-repo add <archive.tar.gz>   Add package to repo (updates index.json)
#   fan-repo remove <name>          Remove package from repo
#   fan-repo list                   List all packages
#   fan-repo info <name>            Show package details
#   fan-repo publish [target]       Deploy repo to server
#   fan-repo serve [port]           Local test server
#   fan-repo set-url <url>          Override repository base URL
#
set -euo pipefail

# ── Config ──────────────────────────────────────────────
REMOTE_HOST="root@185.219.41.46"
REMOTE_PATH="/var/www/fan-repo"
REPO_URL="http://185.219.41.46/fan"
REPO_DIR=""

# ── Colors ──────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

info()  { echo -e "${GREEN}✔${NC} $*"; }
warn()  { echo -e "${YELLOW}!${NC} $*"; }
error() { echo -e "${RED}✖${NC} $*" >&2; exit 1; }
dim()   { echo -e "${DIM}$*${NC}"; }

# ── Helpers ─────────────────────────────────────────────
find_repo_dir() {
    if [[ -n "${FAN_REPO_DIR:-}" && -f "$FAN_REPO_DIR/index.json" ]]; then
        REPO_DIR="$FAN_REPO_DIR"
        return
    fi
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/index.json" ]]; then
            REPO_DIR="$dir"
            return
        fi
        dir=$(dirname "$dir")
    done
    error "Not a fan-repo directory (no index.json found). Run 'fan-repo init' first."
}

require_repo() {
    find_repo_dir
    if [[ ! -f "$REPO_DIR/index.json" ]]; then
        error "index.json not found in $REPO_DIR"
    fi
}

# Extract a field from package.json inside a tar.gz
tar_field() {
    local archive="$1" field="$2"
    local pkg_json_path
    # Prefer root-level package.json (<dirname>/package.json), fall back to any
    pkg_json_path=$(tar -tzf "$archive" 2>/dev/null | grep -E '^[^/]+/package\.json$' | head -1 || true)
    if [[ -z "$pkg_json_path" ]]; then
        pkg_json_path=$(tar -tzf "$archive" 2>/dev/null | grep -m1 'package.json' || true)
    fi
    if [[ -z "$pkg_json_path" ]]; then
        echo ""
        return
    fi
    tar -xzf "$archive" -O "$pkg_json_path" 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    fan = data.get('fan', {})
    if fan.get('$field'):
        print(fan['$field'])
    else:
        print(data.get('$field', ''))
except: print('')
" 2>/dev/null || echo ""
}

# Detect package type from archive contents
detect_type() {
    local archive="$1"
    local contents
    contents=$(tar -tzf "$archive" 2>/dev/null | head -20 || true)
    # Check for SKILL.md and theme.json at root level first
    if echo "$contents" | grep -qE '^[^/]+/SKILL\.md$'; then
        echo "skill"; return
    fi
    if echo "$contents" | grep -qE '^[^/]+/theme\.json$'; then
        echo "theme"; return
    fi
    # Only classify as bundle if extensions/skills/themes are at top level
    if echo "$contents" | grep -qE '^[^/]+/(extensions/|skills/|themes/)'; then
        echo "bundle"; return
    fi
    # Re-check SKILL.md and theme.json without root anchor as fallback
    if echo "$contents" | grep -q 'SKILL.md'; then
        echo "skill"; return
    fi
    if echo "$contents" | grep -q 'theme\.json'; then
        echo "theme"; return
    fi
    if echo "$contents" | grep -qE '(index\.ts|index\.js|package\.json)'; then
        echo "extension"; return
    fi
    echo "unknown"
}

timestamp() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# Rebuild index.json from packages/ directory
rebuild_index() {
    require_repo
    local packages_dir="$REPO_DIR/packages"
    local ts
    ts=$(timestamp)

    local pkg_array="[]"
    if [[ -d "$packages_dir" ]]; then
        pkg_array=$(FAN_PKG_DIR="$packages_dir" FAN_REPO_URL="$REPO_URL" FAN_REPO_DIR="$REPO_DIR" python3 << 'PYEOF'
import json, os, hashlib, glob, tarfile

packages = []
pkg_dir = os.environ["FAN_PKG_DIR"]
repo_url = os.environ["FAN_REPO_URL"]

for archive_path in sorted(glob.glob(os.path.join(pkg_dir, '*.tar.gz')) + glob.glob(os.path.join(pkg_dir, '*.tgz'))):
    filename = os.path.basename(archive_path)

    name = ''
    version = ''
    description = ''
    author = ''

    try:
        with tarfile.open(archive_path, 'r:gz') as tf:
            # Prefer root-level package.json (e.g. "skillname/package.json")
            root_pkg = None
            other_pkg = None
            for member in tf.getmembers():
                if member.name.endswith('package.json'):
                    parts = member.name.split('/')
                    if len(parts) == 2 and member.isfile():
                        root_pkg = member
                        break
                    elif other_pkg is None and member.isfile():
                        other_pkg = member
            target = root_pkg or other_pkg
            if target:
                f = tf.extractfile(target)
                if f:
                    try:
                        data = json.loads(f.read().decode())
                        fan = data.get('fan', {})
                        name = fan.get('name') or data.get('name', '')
                        version = fan.get('version') or data.get('version', '')
                        description = fan.get('description') or data.get('description', '')
                        author = fan.get('author') or data.get('author', '')
                    except: pass
    except: pass

    if not name:
        parts = filename.replace('.tar.gz', '').replace('.tgz', '').rsplit('-', 1)
        if len(parts) == 2:
            name = parts[0]
            version = parts[1]
        else:
            name = parts[0]

    type_ = 'extension'
    try:
        with tarfile.open(archive_path, 'r:gz') as tf:
            names = [m.name for m in tf.getmembers()]
            # Check root-level markers first
            if any(n.split('/')[0] + '/SKILL.md' == n for n in names):
                type_ = 'skill'
            elif any(n.split('/')[0] + '/theme.json' == n for n in names):
                type_ = 'theme'
            # Only classify as bundle if extensions/skills/themes at top level
            elif any(n.startswith(n.split('/')[0] + '/extensions/') or n.startswith(n.split('/')[0] + '/skills/') or n.startswith(n.split('/')[0] + '/themes/') for n in names):
                type_ = 'bundle'
            elif any('SKILL.md' in n for n in names):
                type_ = 'skill'
            elif any('theme.json' in n for n in names):
                type_ = 'theme'
    except: pass

    with open(archive_path, 'rb') as f:
        hash_val = 'sha256:' + hashlib.sha256(f.read()).hexdigest()

    base_url = repo_url.rstrip('/')
    download_url = f'{base_url}/packages/{filename}'

    pkg = {
        'name': name,
        'version': version,
        'type': type_,
        'description': description,
        'downloadUrl': download_url,
        'hash': hash_val,
    }
    if author:
        pkg['author'] = author
    packages.append(pkg)

print(json.dumps(packages, indent=2))
PYEOF
)
    fi

    FAN_PKG_ARRAY="$pkg_array" FAN_REPO_DIR="$REPO_DIR" FAN_REPO_URL="$REPO_URL" FAN_TS="$ts" python3 << 'PYEOF'
import json, os, sys

packages = json.loads(os.environ["FAN_PKG_ARRAY"])
repo_dir = os.environ["FAN_REPO_DIR"]
repo_url = os.environ["FAN_REPO_URL"]
ts = os.environ["FAN_TS"]

repo_name = os.path.basename(repo_dir)

try:
    with open(os.path.join(repo_dir, "index.json")) as f:
        existing = json.load(f)
        repo_name = existing.get("repository", {}).get("name", repo_name)
except: pass

index = {
    "repository": {
        "name": repo_name,
        "url": repo_url,
        "updatedAt": ts
    },
    "packages": packages
}

with open(os.path.join(repo_dir, "index.json"), "w") as f:
    json.dump(index, f, indent=2)
    f.write("\n")

print(f"  {len(packages)} package(s) in index")
PYEOF
}

# ── Commands ────────────────────────────────────────────

cmd_init() {
    local path="${1:-.}"
    path=$(realpath "$path")

    if [[ -f "$path/index.json" ]]; then
        error "Repo already exists at $path"
    fi

    mkdir -p "$path/packages"

    local repo_name
    repo_name=$(basename "$path")

    cat > "$path/index.json" <<EOF
{
  "repository": {
    "name": "$repo_name",
    "url": "$REPO_URL",
    "updatedAt": "$(timestamp)"
  },
  "packages": []
}
EOF

    info "Repository initialized at $path"
    echo ""
    dim "  $path/"
    dim "  ├── index.json"
    dim "  └── packages/"
    echo ""
    dim "Next: fan-repo add ./my-extension-1.0.0.tar.gz"
    dim "       fan-repo publish"
}

cmd_set_url() {
    local url="${1:-}"
    if [[ -z "$url" ]]; then
        echo "Current URL: $REPO_URL"
        return
    fi

    REPO_URL="${url%/}/"
    info "Repository URL set to $REPO_URL"
}

cmd_add() {
    local archive="${1:-}"
    if [[ -z "$archive" ]]; then
        error "Usage: fan-repo add <archive.tar.gz>"
    fi

    archive=$(realpath "$archive")
    if [[ ! -f "$archive" ]]; then
        error "File not found: $archive"
    fi

    if [[ ! "$archive" =~ \.(tar\.gz|tgz)$ ]]; then
        warn "Expected .tar.gz or .tgz archive"
    fi

    require_repo

    local name version description type
    name=$(tar_field "$archive" "name")
    version=$(tar_field "$archive" "version")
    description=$(tar_field "$archive" "description")
    type=$(detect_type "$archive")

    if [[ -z "$name" ]]; then
        local basename_noext
        basename_noext=$(basename "$archive" | sed 's/\.tar\.gz$//' | sed 's/\.tgz$//')
        name=$(echo "$basename_noext" | sed 's/-[^-]*$//')
        version=$(echo "$basename_noext" | sed "s/^${name}-//")
    fi

    echo ""
    echo -e "  ${CYAN}Name:${NC}        $name"
    echo -e "  ${CYAN}Version:${NC}     $version"
    echo -e "  ${CYAN}Type:${NC}        $type"
    echo -e "  ${CYAN}Description:${NC} $description"
    echo ""

    local dest="$REPO_DIR/packages/$(basename "$archive")"
    cp "$archive" "$dest"
    info "Copied to packages/$(basename "$archive")"

    rebuild_index
    info "Package '$name' added to repository"
}

cmd_remove() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        error "Usage: fan-repo remove <name>"
    fi

    require_repo

    local found=0
    for archive in "$REPO_DIR/packages/"*.tar.gz "$REPO_DIR/packages/"*.tgz; do
        [[ -f "$archive" ]] || continue
        local pkg_name
        pkg_name=$(tar_field "$archive" "name")
        if [[ -z "$pkg_name" ]]; then
            pkg_name=$(basename "$archive" | sed 's/\.tar\.gz$//' | sed 's/\.tgz$//' | sed 's/-[^-]*$//')
        fi
        if [[ "$pkg_name" == "$name" ]]; then
            rm "$archive"
            info "Removed $(basename "$archive")"
            found=1
        fi
    done

    if [[ "$found" == "0" ]]; then
        error "Package '$name' not found"
    fi

    rebuild_index
    info "Package '$name' removed from repository"
}

cmd_list() {
    require_repo

    echo ""
    echo -e "  ${CYAN}Repository:${NC}   $(basename "$REPO_DIR")"
    echo -e "  ${CYAN}URL:${NC}          ${REPO_URL:-<not set>}"
    echo -e "  ${CYAN}Directory:${NC}    $REPO_DIR"
    echo ""

    FAN_REPO_DIR="$REPO_DIR" python3 << 'PYEOF'
import json, os, sys

with open(os.path.join(os.environ["FAN_REPO_DIR"], "index.json")) as f:
    data = json.load(f)

packages = data.get("packages", [])
if not packages:
    print("  (empty)")
    sys.exit(0)

for i, pkg in enumerate(packages):
    name = pkg.get("name", "?")
    version = pkg.get("version", "?")
    type_ = pkg.get("type", "?")
    desc = pkg.get("description", "")
    author = pkg.get("author", "")
    hash_ = pkg.get("hash", "")[:16]

    print(f"  {i+1}. {name}@{version}")
    print(f"     type: {type_}")
    if desc:
        print(f"     desc: {desc}")
    if author:
        print(f"     author: {author}")
    print(f"     hash: {hash_}...")
    print()
PYEOF
}

cmd_info() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        error "Usage: fan-repo info <name>"
    fi

    require_repo

    FAN_REPO_DIR="$REPO_DIR" FAN_PKG_NAME="$name" python3 << 'PYEOF'
import json, os, sys

with open(os.path.join(os.environ["FAN_REPO_DIR"], "index.json")) as f:
    data = json.load(f)

packages = data.get("packages", [])
pkg_name = os.environ["FAN_PKG_NAME"]
pkg = next((p for p in packages if p.get("name") == pkg_name), None)
if not pkg:
    print(f"Package not found: {pkg_name}", file=sys.stderr)
    sys.exit(1)

print(json.dumps(pkg, indent=2))
PYEOF
}

cmd_publish() {
    local target="${1:-$REMOTE_HOST:$REMOTE_PATH}"

    require_repo

    rebuild_index

    if [[ "$target" =~ ^s3:// ]]; then
        if ! command -v aws &>/dev/null; then
            error "AWS CLI not installed. Install with: pip install awscli"
        fi
        info "Syncing to S3: $target"
        aws s3 sync "$REPO_DIR/" "$target/" --delete
        info "Published to S3"

    elif [[ "$target" =~ ^https?:// ]]; then
        error "HTTP publish not yet supported. Use rsync: user@host:/path"

    else
        if ! command -v rsync &>/dev/null; then
            error "rsync not installed"
        fi
        info "Syncing to $target ..."
        rsync -avz \
            --exclude='.git/' \
            --exclude='*.bak.*' \
            "$REPO_DIR/" "$target/"
        info "Published to $target"
    fi
}

cmd_serve() {
    local port="${1:-8888}"
    require_repo

    info "Serving repository at http://localhost:$port/"
    dim "  Press Ctrl+C to stop"
    echo ""
    cd "$REPO_DIR"
    python3 -m http.server "$port"
}

cmd_help() {
    echo ""
    echo -e "${CYAN}fan-repo${NC} — FAN package repository manager"
    echo ""
    echo "Usage: fan-repo <command> [args]"
    echo ""
    echo "Commands:"
    echo "  init [path]            Create a new repository directory"
    echo "  set-url <url>          Set repository base URL"
    echo "  add <archive.tar.gz>   Add package to repository"
    echo "  remove <name>          Remove package by name"
    echo "  list                   List all packages"
    echo "  info <name>            Show package details"
    echo "  publish [target]       Deploy to server (default: root@185.219.41.46:/var/www/fan-repo)"
    echo "  serve [port]           Local HTTP server for testing"
    echo "  help                   Show this help"
    echo ""
    echo "Default server: root@185.219.41.46:/var/www/fan-repo"
    echo "Default URL:    http://185.219.41.46/fan/"
    echo "Environment:"
    echo "  FAN_REPO_DIR           Override repository directory"
    echo ""
}

# ── Main ────────────────────────────────────────────────
COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    init)      cmd_init "$@" ;;
    set-url)   cmd_set_url "$@" ;;
    add)       cmd_add "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    list|ls)   cmd_list "$@" ;;
    info|show) cmd_info "$@" ;;
    publish|push|deploy) cmd_publish "$@" ;;
    serve)     cmd_serve "$@" ;;
    help|--help|-h|"") cmd_help ;;
    *)         error "Unknown command: $COMMAND. Run 'fan-repo help'." ;;
esac
