{
	"name": "@fan/store",
	"version": "1.0.1",
	"description": "FAN Store — package manager for extensions, skills, themes from repositories and archives",
	"fan": {
		"name": "fan-store",
		"type": "extension",
		"displayName": "FAN Store",
		"description": "Package manager for extensions, skills, and themes. Browse, install, update, and remove packages from configured repositories.",
		"version": "0.8.2",
		"main": "dist/index.js",
		"entry": "src/store-extension.ts",
		"author": "FAN Team",
		"tags": [
			"store",
			"packages",
			"extensions",
			"skills",
			"themes"
		],
		"bundled": true
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest run"
	},
	"dependencies": {
		"@seaagents/fan-coding-agent": "*",
		"@seaagents/fan-tui": "*",
		"@sinclair/typebox": "^0.34.0"
	},
	"devDependencies": {
		"shx": "^0.4.0",
		"vitest": "^3.2.4"
	}
}
