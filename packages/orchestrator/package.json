{
	"name": "@fan/orchestrator",
	"version": "1.0.0",
	"fan": {
		"name": "fan-orchestrator",
		"type": "extension",
		"displayName": "FAN Orchestrator",
		"description": "Multi-agent orchestrator with delegate_task, task management, workers, and slash commands",
		"version": "1.0.0",
		"main": "dist/index.js",
		"entry": "src/orchestrator-extension.ts",
		"author": "FAN Team",
		"tags": [
			"orchestrator",
			"multi-agent",
			"workers",
			"tasks",
			"planning"
		],
		"bundled": true
	},
	"description": "FAN orchestrator — multi-agent task decomposition and coordination",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"copy-assets": "shx mkdir -p dist/agents dist/prompts && shx cp src/agents/*.md dist/agents/ && shx cp src/prompts/*.md dist/prompts/",
		"build": "tsgo -p tsconfig.build.json && npm run copy-assets",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest run"
	},
	"dependencies": {
		"@itone/fan-ai": "workspace:*",
		"@itone/fan-coding-agent": "workspace:*",
		"@itone/fan-agent-core": "workspace:*",
		"@itone/fan-tui": "workspace:*",
		"@sinclair/typebox": "^0.34.0"
	},
	"devDependencies": {
		"shx": "^0.4.0"
	}
}
