{
	"name": "@fan/orchestrator",
	"version": "0.7.3",
	"fan": {
		"name": "fan-orchestrator",
		"type": "extension",
		"displayName": "FAN Orchestrator v2",
		"description": "Orchestrator extension v2: 8 worker types, RPC mode, Agent/SendMessage/StopAgent tools",
		"version": "2.0.0",
		"main": "dist/index.js",
		"entry": "src/index.ts",
		"author": "FAN Team",
		"tags": [
			"orchestrator",
			"multi-agent",
			"workers",
			"tasks",
			"planning",
			"verification",
			"parallel",
			"delegation"
		],
		"bundled": true
	},
	"description": "FAN orchestrator v2 — multi-agent task decomposition and coordination with RPC workers",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"copy-assets": "shx mkdir -p dist/agents && shx cp src/agents/*.json dist/agents/ 2>/dev/null; true",
		"build": "tsgo -p tsconfig.build.json && npm run copy-assets",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest run"
	},
	"dependencies": {
		"@itone/fan-ai": "*",
		"@itone/fan-coding-agent": "*",
		"@itone/fan-tui": "*",
		"@sinclair/typebox": "^0.34.0"
	},
	"devDependencies": {
		"shx": "^0.4.0"
	}
}
