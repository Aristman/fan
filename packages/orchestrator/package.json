{
	"name": "@fan/orchestrator",
	"version": "1.0.0",
	"description": "FAN orchestrator — multi-agent task decomposition and coordination",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"copy-assets": "shx mkdir -p dist/agents dist/prompts && shx cp src/agents/*.md dist/agents/ && shx cp src/prompts/*.md dist/prompts/",
		"build": "tsgo -p tsconfig.build.json && npm run copy-assets",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest run"
	},
	"dependencies": {
		"@itone/fan-ai": "^0.66.1",
		"@itone/fan-coding-agent": "^0.66.1",
		"@itone/fan-agent-core": "^0.66.1",
		"@itone/fan-tui": "^0.66.1",
		"@sinclair/typebox": "^0.34.0"
	},
	"devDependencies": {
		"shx": "^0.4.0"
	}
}
