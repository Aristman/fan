{
	"name": "@fan/model-manager",
	"version": "0.8.6",
	"description": "FAN model manager — provider routing, fallback chains, budget tracking",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest run"
	},
	"dependencies": {
		"@fan/db": "*",
		"@itone/fan-ai": "*"
	},
	"devDependencies": {
		"shx": "^0.4.0",
		"vitest": "^3.2.4"
	}
}
