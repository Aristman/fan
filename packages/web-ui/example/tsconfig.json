{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"paths": {
			"*": ["./*"],
			"@seaagents/fan-agent-core": ["../../agent/src/index.ts"],
			"@seaagents/fan-agent-core/*": ["../../agent/src/*.ts"],
			"@seaagents/fan-ai": ["../../ai/src/index.ts"],
			"@seaagents/fan-ai/*": ["../../ai/src/*.ts"],
			"@seaagents/fan-tui": ["../../tui/src/index.ts"],
			"@seaagents/fan-tui/*": ["../../tui/src/*.ts"],
			"@seaagents/fan-web-ui": ["../src/index.ts"],
			"@seaagents/fan-web-ui/*": ["../src/*.ts"]
		},
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false
	},
	"include": ["src/**/*"],
	"exclude": ["../src"]
}
